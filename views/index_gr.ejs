<link rel="stylesheet" href="../css/style_min.css">
<script type="text/javascript" defer src="../js/script.js"></script>
<div class="flex flex-col">
    <div class="author">
        <h1 class="author_name"></h1>
        <p class="author_comment"></p>
    </div>

    <section class="mt-28 z-10 articles">
        <ul class="mt-2 mb-20 posts_ul">
        </ul>
    </section>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        let last_id = null,
            loading = false,
            all_loaded = false,
            posts_ul = document.querySelector(".posts_ul");

        async function fetch_more(initialLoad = false) {
            if (loading || all_loaded) return;
            loading = true;

            let url = new URL("/more_posts", window.location.origin);
            if (last_id) url.searchParams.append("last_post", last_id);
            url.searchParams.append("limit", initialLoad ? 2 : 1);
            url.searchParams.append("cache_buster", Date.now());

            try {
                let response = await fetch(url);
                let data = await response.json();

                console.log("Fetched Posts:", data);

                if (data.length > 0) {
                    data.forEach(post => {
                        let posts_li = document.createElement("li");
                        posts_li.classList.add("wipe", "border-b-zinc-800", "border-b-4", "mb-11");
                        posts_li.setAttribute("data-post-id", post._id);
                        posts_li.innerHTML = `
                        <a href="/post/${post._id}">
                            <span class="ml-6 text-base hover:text-zinc-400 md:ml-24 xl:ml-32 2xl:ml-36 font-bold break-words" 
                                style="display:block; max-width:78vw;">
                                ${post.title}
                            </span>
                        </a>
                        <div class="ml-6 mb-4 cursor-default md:ml-24 xl:ml-32 2xl:ml-36">
                            <span class="font-light text-xs">by ${post.username}</span>
                        </div>
                        <div class="break-words flex my-0 mx-auto w-9/12">
                            <p class="mt-2 mb-6 font-light line-clamp-6 text-sm posts md:line-clamp-[7] xl:line-clamp-[10]">
                                ${post.body}
                            </p>
                        </div>
                            <div class="text-center mb-20">
                            <p class="mb-2 font-light text-xs cursor-default post_date">
                                -Ανέβηκε: ${new Intl.DateTimeFormat("el-GR", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit", hour12: !1 }).format(new Date(e.date))}
                            </p>
                            <p class="font-light text-xs cursor-default post_date">
                                -Ενημερώθηκε: ${new Intl.DateTimeFormat("el-GR", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit", hour12: !1 }).format(new Date(e.update_date))}
                            </p>
                        </div>
                    `;

                        posts_ul.appendChild(posts_li);
                        requestAnimationFrame(() => { posts_li.classList.add("visible"); });
                    });

                    last_id = data[data.length - 1]?._id || last_id;
                } else {
                    all_loaded = true;
                    console.log("All posts loaded.");
                }
            } catch (error) {
                console.error("Error loading more posts:", error);
            } finally {
                loading = false;
            }
        }

        fetch_more(true);

        function posts_scroll() {
            console.log("Scroll event triggered");
            if (all_loaded || loading) return;

            let scroll_position = window.innerHeight + window.scrollY;
            let document_height = document.documentElement.scrollHeight;

            console.log("Scroll Pos:", scroll_position, "Doc Height:", document_height);

            if (scroll_position >= document_height - 50) {
                console.log("Fetching more posts...");
                fetch_more();
            }
        }

        window.addEventListener("scroll", () => {
            clearTimeout(window.debounce);
            window.debounce = setTimeout(posts_scroll, 100);
        });
    });

</script>


<style>
    @keyframes wipeAnimation {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .wipe {
        opacity: 0;
        transform: translateY(20px);
    }

    .wipe.visible {
        animation: wipeAnimation 0.8s ease forwards;
    }
</style>