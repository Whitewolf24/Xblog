<section class="mt-28">
    <a href="/users/profile" class="text text-sm ml-5 underline underline-offset-4 hover:text-zinc-400">&larr;
        Πίσω</a>
    <div class="items-center justify-center flex text-center">
        <ul>
            <form action="/add" method="POST" class="mt-8">

                <label for="title">
                    <span class="text-[clamp(0.85rem,2.5vw,0.95rem)] mr-2">Τίτλος</span>
                </label>
                <input type="text" placeholder="Post Title" name="title" id="title"
                    class="bg-gray-200 h-9 focus:outline-none focus:shadow-[inset_0_1px_1px_0_rgba(50,50,50,0.9)] text-xs text-gray-950 px-4 mt-3 rounded-xl min-w-[80%] w-9/12">
                </li>
                <li class="mt-8">
                    <textarea cols="50" rows="10" name="content" placeholder="Content" id="content"
                        class="bg-gray-200 h-[40vh] focus:outline-none focus:shadow-[inset_0_1px_1px_0_rgba(50,50,50,0.9)] text-xs p-4 text-gray-950 rounded-xl w-[50vw]"></textarea>
                </li>
                <button type="submit" value="add" id="add_sub"
                    class="border-solid border-white border-[1px] mt-5 text-[clamp(0.85rem,2.5vw,0.95rem)] p-2 rounded-xl hover:text-zinc-400">Ανάρτηση</button>
            </form>
        </ul>
    </div>
</section>

<script>
    const profile_butt = document.querySelector("#profile_butt"), title = document.querySelector("#title"), content_text = document.querySelector("#content"), submit_butt = document.querySelector("#add_sub"); profile_butt.style.display = "none", submit_butt.addEventListener("click", function (t) { let e = e.value.trim(), l = content_text.value.trim(); e.length < 25 ? (t.preventDefault(), alert("Ο τίτλος πρέπει να έχει τουλάχιστον 25 χαρακτήρες.")) : e.length > 50 && (t.preventDefault(), alert("Ο τίτλος μπορεί να έχει μέχρι 50 χαρακτήρες.")), l.length < 200 ? (t.preventDefault(), alert("Το κείμενο πρέπει να έχει τουλάχιστον 200 χαρακτήρες.")) : l.length > 800 && (t.preventDefault(), alert("Το κείμενο μπορεί να έχει μέχρι 800 χαρακτήρες.")) });
</script>